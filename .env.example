# Скопируйте этот файл в .env и заполните. .env НЕ коммитится.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# API каталога ekt.kz (данные из инструкции партнёра)
EKT_API_USER=YOUR_EKT_API_USER
EKT_API_PASSWORD=YOUR_EKT_API_PASSWORD
EKT_API_BASE=https://ekt.kz/api
# Источник: cache (реальный кэш, для жюри), api (живой API), sample (только тесты)
CATALOG_SOURCE=cache

CART_BASE_URL=http://localhost:8501/
